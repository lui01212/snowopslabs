# Tool Versions Configuration.
#
# Each CLI tool has two numbers:
#   *_MIN_VERSION  the oldest version the lab works with. `labctl doctor` and
#                  bootstrap/setup-tools.sh both accept anything at or above
#                  it, so a user's own newer tool is never replaced.
#                  (internal/toolchain's preflight table must match these; a
#                  Go test enforces it.)
#   *_VERSION      the known-good version downloaded on Linux and WSL when the
#                  tool is missing or older than the minimum. macOS installs
#                  the current release through Homebrew instead.
#
# Last updated: 2026-09-27

# Kubernetes
# kubectl releases: https://github.com/kubernetes/kubernetes/releases
KUBECTL_MIN_VERSION=1.28.0
KUBECTL_VERSION=1.36.1

# k3d (Kubernetes in Docker)
# k3d releases: https://github.com/k3d-io/k3d/releases
K3D_MIN_VERSION=5.6.0
K3D_VERSION=5.8.3

# kind (headless local cluster; powers CI and the nightly e2e job)
# kind releases: https://github.com/kubernetes-sigs/kind/releases
KIND_MIN_VERSION=0.20.0
KIND_VERSION=0.27.0

# Docker
# docker releases: https://docs.docker.com/engine/release-notes/
DOCKER_VERSION=29.2.1

# Helm - 3.12 is the minimum; helm 4 is accepted.
# helm releases: https://github.com/helm/helm/releases
HELM_MIN_VERSION=3.12.0
HELM_VERSION=4.2.3

# ArgoCD CLI (for CD pipeline GitOps sync)
# argocd releases: https://github.com/argoproj/argo-cd/releases
ARGOCD_VERSION=2.10.0

# --- Platform: Service Mesh (platform/mesh/) ---
# These pin the Helm chart versions for the swappable mesh providers.
# Override per-install via the matching env var if you need a different release.

# Istio (istio/base + istio/istiod charts share the app version)
# istio releases: https://github.com/istio/istio/releases
ISTIO_VERSION=1.24.2

# Linkerd stable Helm charts (helm.linkerd.io/stable)
# linkerd-crds chart releases: https://github.com/linkerd/linkerd2/releases
LINKERD_CRDS_CHART_VERSION=1.8.0
# linkerd-control-plane chart releases: https://github.com/linkerd/linkerd2/releases
LINKERD_CONTROL_PLANE_CHART_VERSION=1.16.11

# --- Platform: Data Infrastructure (platform/data/) ---
# Pinned chart/app versions for the additive data sub-components (kafka, postgres).
# Override per-install via the matching env var if you need a different release.

# Kafka via Strimzi operator (KRaft mode)
# strimzi-kafka-operator chart releases: https://github.com/strimzi/strimzi-kafka-operator/releases
STRIMZI_VERSION=1.2.0
# Kafka broker version the operator runs. It MUST appear in the operator's
# STRIMZI_KAFKA_IMAGES list - Strimzi 1.2.0 ships 4.2.0, 4.2.1, 4.3.0 and 4.3.1
# only, so a 3.x broker version is rejected outright. Check before bumping:
#   helm template strimzi/strimzi-kafka-operator --version $STRIMZI_VERSION \
#     | grep -A6 STRIMZI_KAFKA_IMAGES
KAFKA_VERSION=4.3.1
# Client image for the console producer/consumer in the event-driven scenario.
KAFKA_CLIENT_IMAGE=apache/kafka:4.3.1

# Postgres via CloudNativePG operator
# cloudnative-pg chart releases: https://github.com/cloudnative-pg/charts/releases
CNPG_CHART_VERSION=0.23.0

# --- Platform: Secrets Management (platform/secrets/) ---
# Pinned chart versions for the secrets backend (vault) + sync operator (ESO).
# Override per-install via the matching env var if you need a different release.

# HashiCorp Vault (dev mode for the lab)
# hashicorp/vault chart releases: https://github.com/hashicorp/vault-helm/releases
VAULT_CHART_VERSION=0.28.1

# External Secrets Operator
# external-secrets chart releases: https://github.com/external-secrets/external-secrets/releases
ESO_CHART_VERSION=0.10.5

# --- Platform: Autoscaling (platform/autoscaling/) ---
# Pinned chart version for the KEDA event/metric-driven autoscaler.
# Override per-install via the matching env var if you need a different release.

# KEDA (chart version tracks the app version)
# kedacore/keda chart releases: https://github.com/kedacore/charts/releases
KEDA_CHART_VERSION=2.15.1

# --- Platform: Cost Visibility (platform/cost/) ---
# Pinned chart version for the OpenCost per-namespace cost estimator.
# Override per-install via OPENCOST_CHART_VERSION if you need a different release.

# OpenCost
# opencost/opencost chart releases: https://github.com/opencost/opencost-helm-chart/releases
OPENCOST_CHART_VERSION=1.43.2

# --- Platform: Observability (platform/monitoring/, logging/, tracing/) ---
# Every chart below is pinned. An unpinned `helm upgrade --install` silently
# tracks the newest release, so two `labctl init` runs a week apart produce
# different clusters and a lab that "worked last week" cannot be reproduced.

# Prometheus + Alertmanager + kube-state-metrics (kube-prometheus-stack)
# releases: https://github.com/prometheus-community/helm-charts/releases
KUBE_PROMETHEUS_STACK_VERSION=89.2.0

# Grafana, Loki and Tempo moved out of the grafana/ chart repo: those charts are
# marked deprecated there and are maintained in grafana-community from
# 2026-01-30. See docs/adr/ADR-0012 for the migration decision.
GRAFANA_CHARTS_REPO=https://grafana-community.github.io/helm-charts
GRAFANA_CHART_VERSION=13.2.0
LOKI_CHART_VERSION=18.12.0
TEMPO_CHART_VERSION=2.3.0

# Grafana Alloy ships the lab's logs (platform/logging/loki, release
# alloy-logs) and is the OTLP trace collector applications export to
# (observability-sre). Its chart stays in the original grafana repo.
ALLOY_CHARTS_REPO=https://grafana.github.io/helm-charts
# releases: https://github.com/grafana/alloy/releases
ALLOY_CHART_VERSION=1.12.1

# --- Platform: remaining chart pins ---
# ingress-nginx releases: https://github.com/kubernetes/ingress-nginx/releases
INGRESS_NGINX_CHART_VERSION=4.15.1
# traefik releases: https://github.com/traefik/traefik-helm-chart/releases
TRAEFIK_CHART_VERSION=41.4.0
# argo-cd releases: https://github.com/argoproj/argo-helm/releases
ARGOCD_CHART_VERSION=10.7.1
# chaos-mesh releases: https://github.com/chaos-mesh/chaos-mesh/releases
CHAOS_MESH_CHART_VERSION=2.8.4
# kyverno releases: https://github.com/kyverno/kyverno/releases
KYVERNO_CHART_VERSION=3.9.0
# cert-manager releases: https://github.com/cert-manager/cert-manager/releases
CERT_MANAGER_CHART_VERSION=v1.21.1
# kubernetes-dashboard: the old chart lived in the retired kubernetes/dashboard
# repo. releases: https://github.com/kubernetes/dashboard/releases
KUBERNETES_DASHBOARD_CHART_VERSION=7.14.0
